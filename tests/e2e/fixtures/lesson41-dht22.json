    "params": {
     "code": "import dht, time\nfrom machine import Pin\ns = dht.DHT22(Pin(15))\nled = Pin(14, Pin.OUT)\nwhile True:\n    try:\n        s.measure()\n        t = s.temperature()\n        h = s.humidity()\n        print(\"T =\", t, \"C  RH =\", h, \"%\")\n        led.value(1 if t > 35 or h > 85 else 0)\n    except OSError as e:\n        print(\"read error\", e)\n    time.sleep(2)\n",
