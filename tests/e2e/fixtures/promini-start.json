    "params": {
     "code": "// Pro Mini: Blink D13 + PWM D9 + อ่าน A7 (รูบนบอร์ด)\nvoid setup() {\n  pinMode(13, OUTPUT);\n  Serial.begin(9600);\n  analogWrite(9, 64);\n}\n\nvoid loop() {\n  digitalWrite(13, HIGH);\n  Serial.print(\"LED ON A7=\");\n  Serial.println(analogRead(A7));\n  delay(500);\n  digitalWrite(13, LOW);\n  Serial.println(\"LED OFF\");\n  delay(500);\n}\n",
