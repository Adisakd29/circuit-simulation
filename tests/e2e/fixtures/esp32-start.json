        "params": {
          "code": "from machine import Pin, ADC\nimport time\n# ESP32-DevKitC: LED ภายนอกที่ IO2 · ตัวต้านทานปรับค่าที่ IO34\nled = Pin(2, Pin.OUT)\npot = ADC(Pin(34))\npot.atten(ADC.ATTN_11DB)\nwhile True:\n    led.value(not led.value())\n    print(\"IO2 =\", led.value(), \" IO34 =\", pot.read())\n    time.sleep(0.4)\n",
          "autorun": true
        }
