     "code": "from machine import Pin, time_pulse_us\nimport time\ntrig = Pin(14, Pin.OUT)\necho = Pin(15, Pin.IN)\ntrig.value(0)\nwhile True:\n    trig.value(1)\n    time.sleep_us(10)\n    trig.value(0)\n    t = time_pulse_us(echo, 1, 30000)\n    if t > 0:\n        print(\"D =\", round(t / 58, 1))\n    else:\n        print(\"ไม่มีวัตถุ\", t)\n    time.sleep_ms(60)\n",
