        "params": {
          "code": "from machine import Pin, I2C\nfrom lsm6dsox import LSM6DSOX\nimport time\n# Nano RP2040 Connect: LED ภายนอกที่ D2 · LED บนบอร์ด (D13) · IMU LSM6DSOX บนบอร์ด (บัส I²C ของ A4/A5)\nled = Pin(\"D2\", Pin.OUT)\nonb = Pin(\"LED\", Pin.OUT)\nimu = LSM6DSOX(I2C(0, scl=Pin(13), sda=Pin(12)))\nwhile True:\n    led.toggle()\n    onb.value(led.value())\n    ax, ay, az = imu.accel()\n    print(\"D2 = %d  accel g: %.2f %.2f %.2f\" % (led.value(), ax, ay, az))\n    time.sleep(0.4)\n",
          "autorun": true,
          "motion": "still",
          "spm": 100
        }
