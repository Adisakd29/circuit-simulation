    "params": {
     "code": "// Mega 2560: Blink D13 + Serial (USB) + Serial1 (D18 TX) + PWM D46 (Timer5)\nvoid setup() {\n  pinMode(13, OUTPUT);\n  Serial.begin(9600);\n  Serial1.begin(9600);\n  analogWrite(46, 64);\n}\n\nvoid loop() {\n  digitalWrite(13, HIGH);\n  Serial.println(\"LED ON\");\n  Serial1.println(\"MEGA S1\");\n  delay(500);\n  digitalWrite(13, LOW);\n  Serial.println(\"LED OFF\");\n  delay(500);\n}\n",
