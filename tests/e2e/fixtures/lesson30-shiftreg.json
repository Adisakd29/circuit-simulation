   {
    "id": "PICO1",
    "label": "PICO1",
    "kind": "pico",
    "placement": {
     "kind": "table",
     "x": -40,
     "z": 4,
     "rotation": 0
    },
    "params": {
     "code": "from machine import Pin\nimport time\nser = Pin(2, Pin.OUT)\nsrclk = Pin(3, Pin.OUT)\nrclk = Pin(4, Pin.OUT)\n\ndef show(b):\n    # ส่งบิตสูงสุดก่อน (บิตที่ส่งก่อนไปอยู่ QH)\n    for i in range(8):\n        ser.value((b >> (7 - i)) & 1)\n        srclk.value(1)\n        srclk.value(0)\n    rclk.value(1)\n    rclk.value(0)\n\nwhile True:\n    for i in range(8):\n        show(1 << i)  # ไฟวิ่ง QA → QH\n        time.sleep(0.15)\n    show(0b10101010)\n    time.sleep(0.4)\n    show(0b00001111)\n    time.sleep(0.4)\n",
     "autorun": true
    }
   },
