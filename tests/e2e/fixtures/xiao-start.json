        "params": {
          "code": "from machine import Pin\nimport neopixel, time\n# XIAO RP2040: LED ภายนอกที่ D0 · LED RGB บนบอร์ด (ติดเมื่อ LOW) · NeoPixel บนบอร์ด (ต้องเปิดไฟที่ NEOPIXEL_POWER)\nled = Pin(\"D0\", Pin.OUT)\nblue = Pin(\"LED_B\", Pin.OUT)\nPin(\"NEOPIXEL_POWER\", Pin.OUT).value(1)\nnp = neopixel.NeoPixel(Pin(\"NEOPIXEL\"), 1)\ncolors = [(255, 0, 0), (0, 255, 0), (0, 0, 255)]\nk = 0\nwhile True:\n    led.toggle()\n    blue.value(k % 2)\n    np[0] = colors[k % 3]\n    np.write()\n    print(\"D0 =\", led.value(), \" NeoPixel =\", colors[k % 3])\n    k += 1\n    time.sleep(0.5)\n",
          "autorun": true
        }
