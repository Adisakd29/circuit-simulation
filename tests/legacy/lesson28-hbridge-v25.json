        "params": {
          "code": "from machine import Pin, PWM\nimport time\na1 = Pin(14, Pin.OUT)   # 1A\na2 = Pin(15, Pin.OUT)   # 2A\nen = PWM(Pin(16))       # 1,2EN\nen.freq(200)\n\ndef run(d1, d2, duty, t):\n    a1.value(d1)\n    a2.value(d2)\n    en.duty_u16(duty)\n    time.sleep(t)\n\nwhile True:\n    run(1, 0, 65535, 1.5)   # เดินหน้า\n    run(0, 0, 65535, 0.5)   # เบรก\n    run(0, 1, 65535, 1.5)   # ถอยหลัง\n    run(0, 1, 30000, 1.5)   # ถอยหลังช้า\n    run(0, 0, 0, 0.5)       # หยุด\n",
          "autorun": true
        }
